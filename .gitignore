# モンスター追加ツールの素材と出力(サイズが大きいのでgitには入れない)
assets/
tools/out/
__pycache__/
*.pyc

# 技エフェクトの撮影結果(tools/fx_shot.mjs の出力)。撮り直せる派生物なので追跡しない
shots/

# シェアカードのプレビュー画像(tools/share_shot.mjs の出力)。撮り直せる派生物なので追跡しない
tools/_share_preview/

# 作業中の画面スクショ(検証用に撮り直せる派生物)。追跡しない
shots_agent/

# フック(tools/hooks/)が「同じ中身で二度回さない」ために控えるハッシュ。端末ごとの状態
.claude/hooks-cache/

# APEXリザルトの参考画像(発注者支給。他社の著作物なのでリポジトリへ入れない)
.claude/apex-ref/

# Claude Code の端末ごとの許可設定(共有しない)
.claude/settings.local.json
