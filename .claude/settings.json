{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR:-.}/tools/hooks/js_syntax.sh",
            "timeout": 30,
            "statusMessage": "構文チェック(node --check)"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR:-.}/tools/hooks/changelog.sh",
            "timeout": 30,
            "statusMessage": "更新履歴の検査"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR:-.}/tools/hooks/cache_bump.sh",
            "timeout": 30,
            "statusMessage": "sw.js の CACHE_NAME を確認"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR:-.}/tools/hooks/layout.sh",
            "timeout": 400,
            "statusMessage": "画面レイアウトの検査(最大4分)"
          }
        ]
      }
    ]
  }
}
